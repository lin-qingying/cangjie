/**
 * This resolver is responsible for [EXPECT_ACTUAL_MATCHING][CfirResolvePhase.EXPECT_ACTUAL_MATCHING] phase.
 *
 * This resolver:
 * - Searches and set [expectForActual][org.cangnova.cangjie.cfir.declarations.expectForActual]
 *   property for declarations.
 *
 * Special rules:
 * - Cfirst resolves outer classes to this phase in multiplatform projects.
 *
 * @see CfirExpectActualMatcherTransformer
 * @see CfirResolvePhase.EXPECT_ACTUAL_MATCHING
 */
private class LLCfirExpectActualMatchingTargetResolver(target: LLCfirResolveTarget) : LLCfirTargetResolver(
    target,
    CfirResolvePhase.EXPECT_ACTUAL_MATCHING
) {
    private val enabled = resolveTargetSession.languageVersionSettings.supportsFeature(LanguageFeature.MultiPlatformProjects)

    @Deprecated("Should never be called directly, only for override purposes, please use withRegularClass", level = DeprecationLevel.ERROR)
    override fun withContainingRegularClass(firClass: CfirRegularClass, action: () -> Unit) {
        if (enabled) {
            // Resolve outer classes before resolving inner declarations. It's the requirement of CfirExpectActualResolver
            firClass.lazyResolveToPhase(resolverPhase.previous)
            performResolve(firClass)
        }
        action()
    }

    private val transformer = object : CfirExpectActualMatcherTransformer(resolveTargetSession, resolveTargetScopeSession) {
        override fun transformRegularClass(regularClass: CfirRegularClass, data: Nothing?): CfirStatement {
            transformMemberDeclaration(regularClass)
            return regularClass
        }
    }

    override fun doLazyResolveUnderLock(target: CfirElementWithResolveState) {
        if (enabled && target is CfirMemberDeclaration && target.canHaveExpectCounterPart()) {
            transformer.transformMemberDeclaration(target)
        }
    }
}

private fun CfirMemberDeclaration.canHaveExpectCounterPart(): Boolean = when (this) {
    // We shouldn't try to calculate expect/actual mapping for fake declarations
    is CfirCallableDeclaration if canHaveDeferredReturnTypeCalculation -> false
    is CfirEnumEntry -> true
    is CfirProperty -> true
    is CfirConstructor -> true
    is CfirNamedFunction -> true
    is CfirRegularClass -> true
    is CfirTypeAlias -> true
    else -> false
}

