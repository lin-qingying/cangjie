internal class LLCombinedSyntheticFunctionSymbolProvider private constructor(
    session: CfirSession,
    override val providers: List<CfirSyntheticFunctionInterfaceProviderBase>,
) : LLCombinedSymbolProvider<CfirSyntheticFunctionInterfaceProviderBase>(session) {
    private val combinedPackageNames: Set<FqName> = providers.flatMapTo(mutableSetOf()) { it.getFunctionKindPackageNames() }

