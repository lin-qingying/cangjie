private fun <E : CfirElement> CfirTransformer<PersistentList<CfirDeclaration>>.recursiveTransformation(
    element: E,
    data: PersistentList<CfirDeclaration>,
): E {
    if (element is CfirFile || element is CfirScript || element is CfirRegularClass) {
        val newList = data.add(element as CfirDeclaration)
        element.transformChildren(this, newList)
    }

    return element
}

@OptIn(ExperimentalContracts::class)
private fun needCalculatingLazyContractsForFunction(function: CfirFunction): Boolean {
    contract {
        returns(true) implies (function is CfirContractDescriptionOwner)
    }

    if (function !is CfirContractDescriptionOwner) return false

    return when (val contractDescription = function.contractDescription) {
        null -> false
        is CfirRawContractDescription -> contractDescription.rawEffects.any { it is CfirLazyExpression }
        is CfirLazyContractDescription -> true
        is CfirLegacyRawContractDescription, is CfirErrorContractDescription, is CfirResolvedContractDescription -> errorWithAttachment("Unexpected contract description type: ${contractDescription::class.simpleName}") {
            withCfirEntry("function", function)
        }
    }
}

private fun needCalculatingLazyContractsForProperty(property: CfirProperty): Boolean {
    return property.getter?.let(::needCalculatingLazyContractsForFunction) == true ||
            property.setter?.let(::needCalculatingLazyContractsForFunction) == true
}

private object CfirAllLazyContractsCalculatorTransformer : CfirLazyContractsCalculatorTransformer() {
    override fun <E : CfirElement> transformElement(element: E, data: PersistentList<CfirDeclaration>): E {
        return recursiveTransformation(element, data)
    }
}

private fun calculateLazyContractsForFunction(designation: CfirDesignation) {
    val function = designation.target as CfirFunction
    require(needCalculatingLazyContractsForFunction(function))

    val newFunction = revive<CfirFunction>(designation, function.originalPsi)
    requireWithAttachment(newFunction is CfirContractDescriptionOwner, { "Unexpected function type: ${newFunction::class.simpleName}" }) {
        withCfirEntry("originalFunction", function)
        withCfirEntry("newFunction", newFunction)
    }

    replaceLazyContracts(target = function, copy = newFunction)
}

private fun calculateLazyContractsForProperty(designation: CfirDesignation) {
    val property = designation.target as CfirProperty
    require(needCalculatingLazyContractsForProperty(property))

    val newProperty = revive<CfirProperty>(designation, property.originalPsi)
    property.getter?.let { getter ->
        val newGetter = newProperty.getter!!
        replaceLazyContracts(target = getter, copy = newGetter)
    }

    property.setter?.let { setter ->
        val newSetter = newProperty.setter!!
        replaceLazyContracts(target = setter, copy = newSetter)
    }
}

private fun <F> replaceLazyContracts(target: F, copy: F) where F : CfirFunction, F : CfirContractDescriptionOwner {
    val contractDescription = copy.contractDescription
    target.replaceContractDescription(contractDescription)

    if (contractDescription is CfirLegacyRawContractDescription) {
        replaceLazyBody(target = target, copy = copy, isContractResolved = false)
    }
}

private object CfirTargetLazyContractsCalculatorTransformer : CfirLazyContractsCalculatorTransformer()

private sealed class CfirLazyContractsCalculatorTransformer : CfirTransformer<PersistentList<CfirDeclaration>>() {
    override fun <E : CfirElement> transformElement(element: E, data: PersistentList<CfirDeclaration>): E = element

    override fun transformNamedFunction(
        namedFunction: CfirNamedFunction,
        data: PersistentList<CfirDeclaration>,
    ): CfirNamedFunction {
        if (needCalculatingLazyContractsForFunction(namedFunction)) {
            val designation = CfirDesignation(data, namedFunction)
            calculateLazyContractsForFunction(designation)
        }

        return namedFunction
    }

    override fun transformConstructor(
        constructor: CfirConstructor,
        data: PersistentList<CfirDeclaration>,
    ): CfirConstructor {
        if (needCalculatingLazyContractsForFunction(constructor)) {
            val designation = CfirDesignation(data, constructor)
            calculateLazyContractsForFunction(designation)
        }

        return constructor
    }

    override fun transformProperty(property: CfirProperty, data: PersistentList<CfirDeclaration>): CfirProperty {
        if (needCalculatingLazyContractsForProperty(property)) {
