// RUN_PIPELINE_TILL: FRONTEND
// 注释：行注释、块注释、块注释可嵌套、文档注释（/// 与 /** */）、字符串里的注释序列只是字符、注释出现在语句中间与文件末尾。
// 官方依据：cjc 1.0.5 / 1.1.3 零诊断（含 /* a /* b */ b */ 嵌套形式）。
/// 这是一个文档注释。
/** 这是一个块文档注释。 */
func comments(): Int64 {
    // 行注释
    let a = 1 // 行尾注释
    /* 块注释 */
    let b = 2
    /* 外层 /* 内层 */ 仍是外层 */
    let c = a + /* 中间 */ b
    let d = "字符串里的 // 与 /* 都只是字符"
    let e = '另一个 /* 字符串'
    let _ = (d, e)
    return c
}
// 文件末尾的注释
