import dep.*

main() {
    <!APILEVEL_REF_HIGHER!>A().foo()<!>
    <!APILEVEL_REF_HIGHER!>Option<Int64>.None.foo()<!>
    <!APILEVEL_REF_HIGHER!>1.foo()<!>
    0
}
