package dep

public interface I {
    func foo(): Unit
}

public class A {}

extend A <: I {
    public func foo() {}
}

extend ?Int64 <: I {
    public func foo(): Unit {}
}

extend Int64 <: I {
    public func foo(): Unit {}
}

