


main(): Int64 {
    var a1: Int8 = 1
    var b1: UInt8 = 1
    a1 << b1
    a1 >> b1

    var a2: Int16 = 1
    var b2: UInt8 = 1
    a2 << b2
    a2 >> b2

    var a3: UInt8 = 1
    var b3: Int16 = 1
    a3 << b3
    a3 >> b3

    var a4: UInt64 = 1
    var b4: UInt32 = 1
    a4 << b4
    a4 >> b4
    return 0
}
