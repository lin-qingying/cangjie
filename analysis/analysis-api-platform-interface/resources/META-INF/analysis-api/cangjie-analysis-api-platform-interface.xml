<idea-plugin>
  <extensions defaultExtensionNs="com.intellij">
    <registryKey
        defaultValue="false"
        description="Enables Cangjie Analysis API statistics collection and reporting to OpenTelemetry."
        key="cangjie.analysis.statistics"
        restartRequired="true"
    />
  </extensions>

  <extensionPoints>
    <extensionPoint
        qualifiedName="org.cangnova.cangjie.cangjieGlobalSearchScopeMergeStrategy"
        interface="org.cangnova.cangjie.analysis.api.platform.projectStructure.CangJieGlobalSearchScopeMergeStrategy"
        area="IDEA_PROJECT"
        dynamic="true"
    />
    <extensionPoint
        qualifiedName="org.cangnova.cangjie.cangjieContentScopeRefiner"
        interface="org.cangnova.cangjie.analysis.api.platform.projectStructure.CaContentScopeRefiner"
        area="IDEA_PROJECT"
        dynamic="true"
    />
  </extensionPoints>
</idea-plugin>
