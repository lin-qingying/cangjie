<idea-plugin xmlns:xi="http://www.w3.org/2001/XInclude">
  <xi:include href="/META-INF/analysis-api/cangjie-analysis-api-impl-base.xml"/>

  <extensions defaultExtensionNs="com.intellij">
    <applicationService
        serviceInterface="org.cangnova.cangjie.analysis.api.platform.permissions.CaAnalysisPermissionOptions"
        serviceImplementation="org.cangnova.cangjie.analysis.api.standalone.base.permissions.CaStandaloneAnalysisPermissionOptions"
    />
    <projectService
        serviceImplementation="org.cangnova.cangjie.analysis.api.standalone.platform.CaStandalonePlatformState"
    />
    <projectService
        serviceInterface="org.cangnova.cangjie.analysis.api.platform.restrictedAnalysis.CaRestrictedAnalysisService"
        serviceImplementation="org.cangnova.cangjie.analysis.api.standalone.platform.CaStandaloneRestrictedAnalysisService"
    />
    <projectService
        serviceInterface="org.cangnova.cangjie.analysis.api.platform.lifetime.CaLifetimeTokenFactory"
        serviceImplementation="org.cangnova.cangjie.analysis.api.platform.lifetime.CaAlwaysAccessibleLifetimeTokenFactory"
    />
    <projectService
        serviceInterface="org.cangnova.cangjie.analysis.api.platform.CaPlatformSettings"
        serviceImplementation="org.cangnova.cangjie.analysis.api.standalone.platform.CaStandalonePlatformSettings"
    />
    <projectService
        serviceInterface="org.cangnova.cangjie.analysis.api.platform.projectStructure.CangJieProjectStructureProvider"
        serviceImplementation="org.cangnova.cangjie.analysis.api.standalone.platform.CaStandaloneProjectStructureProvider"
    />
    <projectService
        serviceInterface="org.cangnova.cangjie.analysis.api.platform.projectStructure.CaModuleProvider"
        serviceImplementation="org.cangnova.cangjie.analysis.api.standalone.platform.CaStandaloneModuleProvider"
    />
    <projectService
        serviceInterface="org.cangnova.cangjie.analysis.api.platform.projectStructure.CaResolutionScopeProvider"
        serviceImplementation="org.cangnova.cangjie.analysis.api.standalone.platform.CaStandaloneResolutionScopeProvider"
    />
    <projectService
        serviceInterface="org.cangnova.cangjie.analysis.api.platform.modification.CaModificationTracker"
        serviceImplementation="org.cangnova.cangjie.analysis.api.standalone.platform.CaStandaloneModificationTracker"
    />
    <projectService
        serviceInterface="org.cangnova.cangjie.analysis.api.platform.modification.CaSessionInvalidationService"
        serviceImplementation="org.cangnova.cangjie.analysis.api.standalone.platform.CaStandaloneSessionInvalidationService"
    />
    <projectService
        serviceInterface="org.cangnova.cangjie.analysis.api.platform.declarations.CangJieDeclarationProviderFactory"
        serviceImplementation="org.cangnova.cangjie.analysis.api.standalone.base.declarations.CangJieStandaloneDeclarationProviderFactory"
    />
    <projectService
        serviceInterface="org.cangnova.cangjie.analysis.api.platform.declarations.CangJieDeclarationProviderMerger"
        serviceImplementation="org.cangnova.cangjie.analysis.api.standalone.base.declarations.CangJieStandaloneDeclarationProviderMerger"
    />
    <projectService
        serviceInterface="org.cangnova.cangjie.analysis.api.platform.packages.CangJiePackageProviderFactory"
        serviceImplementation="org.cangnova.cangjie.analysis.api.standalone.base.packages.CangJieStandalonePackageProviderFactory"
    />
    <projectService
        serviceInterface="org.cangnova.cangjie.analysis.api.platform.packages.CangJiePackageProviderMerger"
        serviceImplementation="org.cangnova.cangjie.analysis.api.standalone.base.packages.CangJieStandalonePackageProviderMerger"
    />
    <projectService
        serviceInterface="org.cangnova.cangjie.analysis.api.platform.declarations.CangJieAnnotationsResolverFactory"
        serviceImplementation="org.cangnova.cangjie.analysis.api.standalone.base.declarations.CangJieStandaloneAnnotationsResolverFactory"
    />
  </extensions>
</idea-plugin>
