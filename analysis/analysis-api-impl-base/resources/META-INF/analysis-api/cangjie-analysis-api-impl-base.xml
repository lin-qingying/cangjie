<idea-plugin>
  <extensionPoints>
    <extensionPoint
        qualifiedName="org.cangnova.cangjie.psiReferenceProvider"
        interface="org.cangnova.cangjie.references.CangJiePsiReferenceProviderContributor"
        area="IDEA_PROJECT"
        dynamic="true"
    />
  </extensionPoints>

  <extensions defaultExtensionNs="com.intellij">
    <applicationService
        serviceInterface="org.cangnova.cangjie.analysis.api.permissions.CaAnalysisPermissionRegistry"
        serviceImplementation="org.cangnova.cangjie.analysis.api.impl.base.permissions.CaBaseAnalysisPermissionRegistry"
    />
    <applicationService
        serviceInterface="org.cangnova.cangjie.analysis.api.platform.permissions.CaAnalysisPermissionOptions"
        serviceImplementation="org.cangnova.cangjie.analysis.api.impl.base.permissions.CaBaseAnalysisPermissionOptions"
    />

    <projectService
        serviceInterface="org.cangnova.cangjie.analysis.api.platform.permissions.CaAnalysisPermissionChecker"
        serviceImplementation="org.cangnova.cangjie.analysis.api.impl.base.permissions.CaBaseAnalysisPermissionChecker"
    />
    <projectService
        serviceInterface="org.cangnova.cangjie.analysis.api.platform.restrictedAnalysis.CaRestrictedAnalysisService"
        serviceImplementation="org.cangnova.cangjie.analysis.api.impl.base.restrictedAnalysis.CaBaseRestrictedAnalysisService"
    />
    <projectService
        serviceImplementation="org.cangnova.cangjie.analysis.api.impl.base.projectStructure.CaIdeProjectStructureState"
    />
    <projectService
        serviceInterface="org.cangnova.cangjie.analysis.api.platform.projectStructure.CangJieProjectStructureProvider"
        serviceImplementation="org.cangnova.cangjie.analysis.api.impl.base.projectStructure.CaIdeProjectStructureProvider"
    />
    <projectService
        serviceInterface="org.cangnova.cangjie.analysis.api.platform.projectStructure.CaModuleProvider"
        serviceImplementation="org.cangnova.cangjie.analysis.api.impl.base.projectStructure.CaIdeModuleProvider"
    />
    <projectService
        serviceInterface="org.cangnova.cangjie.analysis.api.projectStructure.CaModuleProvider"
        serviceImplementation="org.cangnova.cangjie.analysis.api.impl.base.projectStructure.CaBaseModuleProvider"
    />
    <projectService
        serviceInterface="org.cangnova.cangjie.analysis.api.platform.projectStructure.CaContentScopeRefiner"
        serviceImplementation="org.cangnova.cangjie.analysis.api.impl.base.projectStructure.CaIdeContentScopeRefiner"
    />
    <projectService
        serviceInterface="org.cangnova.cangjie.analysis.api.platform.projectStructure.CaResolutionScopeProvider"
        serviceImplementation="org.cangnova.cangjie.analysis.api.impl.base.projectStructure.CaIdeResolutionScopeProvider"
    />
    <projectService
        serviceInterface="org.cangnova.cangjie.analysis.api.platform.projectStructure.CangJieModuleDependentsProvider"
        serviceImplementation="org.cangnova.cangjie.analysis.api.impl.base.projectStructure.CaIdeModuleDependentsProvider"
    />
    <projectService
        serviceInterface="org.cangnova.cangjie.analysis.api.platform.CangJieMessageBusProvider"
        serviceImplementation="org.cangnova.cangjie.analysis.api.platform.CangJieProjectMessageBusProvider"
    />
    <projectService
        serviceInterface="org.cangnova.cangjie.analysis.api.platform.modification.CaModificationTracker"
        serviceImplementation="org.cangnova.cangjie.analysis.api.impl.base.projectStructure.CaIdeModificationTracker"
    />
    <projectService
        serviceInterface="org.cangnova.cangjie.analysis.api.platform.modification.CaSessionInvalidationService"
        serviceImplementation="org.cangnova.cangjie.analysis.api.impl.base.projectStructure.CaIdeSessionInvalidationService"
    />
    <projectService
        serviceInterface="org.cangnova.cangjie.analysis.api.platform.lifetime.CaLifetimeTracker"
        serviceImplementation="org.cangnova.cangjie.analysis.api.impl.base.lifetime.CaBaseLifetimeTracker"
    />
    <projectService
        serviceInterface="org.cangnova.cangjie.analysis.api.platform.lifetime.CaLifetimeTokenFactory"
        serviceImplementation="org.cangnova.cangjie.analysis.api.impl.base.lifetime.CaBaseLifetimeTokenFactory"
    />
    <projectService
        serviceInterface="org.cangnova.cangjie.analysis.api.platform.CaPlatformSettings"
        serviceImplementation="org.cangnova.cangjie.analysis.api.impl.base.platform.CaBasePlatformSettings"
    />
    <projectService
        serviceInterface="org.cangnova.cangjie.analysis.api.platform.declarations.CangJieDeclarationProviderFactory"
        serviceImplementation="org.cangnova.cangjie.analysis.api.impl.base.platform.declarations.CaIdeDeclarationProviderFactory"
    />
    <projectService
        serviceInterface="org.cangnova.cangjie.analysis.api.platform.declarations.CangJieDeclarationProviderMerger"
        serviceImplementation="org.cangnova.cangjie.analysis.api.impl.base.platform.declarations.CaIdeDeclarationProviderMerger"
    />
    <projectService
        serviceInterface="org.cangnova.cangjie.analysis.api.platform.packages.CangJiePackageProviderFactory"
        serviceImplementation="org.cangnova.cangjie.analysis.api.impl.base.platform.packages.CaIdePackageProviderFactory"
    />
    <projectService
        serviceInterface="org.cangnova.cangjie.analysis.api.platform.packages.CangJiePackageProviderMerger"
        serviceImplementation="org.cangnova.cangjie.analysis.api.impl.base.platform.packages.CaIdePackageProviderMerger"
    />
    <projectService
        serviceInterface="org.cangnova.cangjie.analysis.api.platform.declarations.CangJieAnnotationsResolverFactory"
        serviceImplementation="org.cangnova.cangjie.analysis.api.impl.base.platform.declarations.CaIdeAnnotationsResolverFactory"
    />
  </extensions>
</idea-plugin>
